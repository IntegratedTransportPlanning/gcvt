    # debug
}

http://localhost:2016 {
    route /tiles* {
        uri strip_prefix /tiles
        root * src/backend/data/processed/tiles/
        file_server
    }

    route /map* {
        uri strip_prefix /map
        root * src/frontend/www/
        file_server
    }

    route /api* {
        uri strip_prefix /api
        reverse_proxy localhost:8000 {
            header_up Host {host} # Forward original host header
        }
    }

    route {
        redir / /map/ 307
    }
}
